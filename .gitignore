# ============================================================
# Python
# ============================================================
__pycache__/                 # Python 字节码缓存
*.py[cod]                    # 编译后的 Python 文件
*.so                         # C 扩展
*.egg-info/                  # Python 包信息
dist/                        # 打包输出目录
build/                       # 构建目录

# ============================================================
# 虚拟环境
# ============================================================
venv/                        # Python 虚拟环境
.env                         # 环境变量配置（含 API Key 等敏感信息）
.venv/

# ============================================================
# IDE
# ============================================================
.idea/                       # PyCharm 项目配置
.vscode/                     # VS Code 配置
*.swp                        # Vim 临时文件
*.swo

# ============================================================
# 数据库
# ============================================================
*.db                         # SQLite 数据库文件
*.db-journal                 # SQLite 日志文件

# ============================================================
# 操作系统
# ============================================================
.DS_Store                    # macOS 文件元数据
Thumbs.db                    # Windows 缩略图缓存

# ============================================================
# 日志
# ============================================================
*.log                        # 日志文件
logs/

# ============================================================
# 运行时生成的文件（项目运行自动产生，无需提交）
# ============================================================
photo/                       # 文章配图（运行时自动下载）
digest/                      # 简报 HTML 文件（运行时自动生成）

