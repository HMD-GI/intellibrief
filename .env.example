# 数据库连接地址（默认使用本地 SQLite 文件）
DATABASE_URL=sqlite:///./intellibrief.db

# Redis 连接地址（用于 Celery 消息队列和文章去重缓存）
REDIS_URL=redis://localhost:6379/0

# 第一步筛选 LLM 配置（多个 Key 用英文逗号分隔）
FIRST_LLM_API_KEYS=your_first_llm_api_key_1,your_first_llm_api_key_2
FIRST_LLM_MODEL=your_first_model
FIRST_LLM_BASE_URL=https://your-first-llm-api-base-url

# 第二步摘要 LLM 配置（多个 Key 用英文逗号分隔）
SECOND_LLM_API_KEYS=your_second_llm_api_key_1,your_second_llm_api_key_2
SECOND_LLM_MODEL=your_second_model
SECOND_LLM_BASE_URL=https://your-second-llm-api-base-url

# 第三步分类 LLM 配置（多个 Key 用英文逗号分隔）
THIRD_LLM_API_KEYS=your_third_llm_api_key_1,your_third_llm_api_key_2
THIRD_LLM_MODEL=your_third_model
THIRD_LLM_BASE_URL=https://your-third-llm-api-base-url

# 默认关注的主题列表（JSON 数组格式）
DEFAULT_TOPICS=["大模型","AI应用","前沿科技"]

# 发件人邮箱地址
EMAIL_SENDER=your_email@example.com
# 发件人邮箱密码或授权码
EMAIL_PASSWORD=your_email_password
# 收件人邮箱地址（多个用英文逗号分隔）
EMAIL_RECEIVERS=receiver1@example.com,receiver2@example.com
# SMTP 服务器配置，可被前端绑定设置覆盖
EMAIL_SMTP_HOST=smtp.qq.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USE_SSL=true
# 飞书机器人 Webhook 地址
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/your_webhook_id
