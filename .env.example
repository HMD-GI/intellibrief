# 数据库连接地址（默认使用本地 SQLite 文件）
DATABASE_URL=sqlite:///./intellibrief.db

# Redis 连接地址（用于 Celery 消息队列和文章去重缓存）
REDIS_URL=redis://localhost:6379/0

# 筛选 LLM 的 API Key（多个 Key 用英文逗号分隔，默认模型 glm-4.7-flash + 智谱接口）
FILTER_LLM_API_KEYS=your_filter_llm_api_key_1,your_filter_llm_api_key_2

# 摘要 LLM 的 API Key（多个 Key 用英文逗号分隔，默认模型 deepseek-v4-pro + DeepSeek 接口）
SUMMARY_LLM_API_KEYS=your_summary_llm_api_key_1,your_summary_llm_api_key_2

# 默认关注的主题列表（JSON 数组格式）
DEFAULT_TOPICS=["大模型","AI应用","前沿科技"]

# 发件人邮箱地址
EMAIL_SENDER=your_email@example.com
# 发件人邮箱密码或授权码
EMAIL_PASSWORD=your_email_password
# 收件人邮箱地址（多个用英文逗号分隔）
EMAIL_RECEIVERS=receiver1@example.com,receiver2@example.com
# 飞书机器人 Webhook 地址
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/your_webhook_id
