# =========================
# 数据库与缓存
# =========================
# PostgreSQL 连接地址。
# 当前项目默认使用 PostgreSQL，不再建议直接使用 SQLite 作为主库。
DATABASE_URL=postgresql+psycopg2://postgres:123456@127.0.0.1:5432/intellibrief_pg

# 仅用于历史 SQLite 数据迁移脚本读取旧库。
SQLITE_MIGRATION_SOURCE=intellibrief.db

# Redis 主连接地址。
# 用于 Celery、天气最近查询缓存、文章增量抓取游标等场景。
REDIS_URL=redis://:123456@127.0.0.1:6379/0

# Redis 无密码回退地址。
# 仅在本地 Redis 未设置密码但主地址失败时兜底使用。
REDIS_FALLBACK_URL=redis://127.0.0.1:6379/0

# =========================
# 大模型配置
# =========================
# 设计说明：
# 1. first / second / third 是三个用途槽位，不代表具体厂商。
# 2. 代码只依赖这三组环境变量，因此换模型只改这里即可。
# 3. 多个 Key 用英文逗号分隔，系统会自动轮询。

# 第一步：筛选模型
FIRST_LLM_API_KEYS=your_first_llm_api_key_1,your_first_llm_api_key_2
FIRST_LLM_MODEL=your_first_llm_model_name
FIRST_LLM_BASE_URL=https://your-first-llm-base-url

# 第二步：摘要模型
SECOND_LLM_API_KEYS=your_second_llm_api_key_1,your_second_llm_api_key_2
SECOND_LLM_MODEL=your_second_llm_model_name
SECOND_LLM_BASE_URL=https://your-second-llm-base-url

# 第三步：分类模型
THIRD_LLM_API_KEYS=your_third_llm_api_key_1,your_third_llm_api_key_2
THIRD_LLM_MODEL=your_third_llm_model_name
THIRD_LLM_BASE_URL=https://your-third-llm-base-url

# =========================
# 业务默认配置
# =========================
# 默认主题列表，使用 JSON 数组格式。
DEFAULT_TOPICS=["国外新闻","AI资讯"]

# 前端允许访问后端的来源地址，多项用英文逗号分隔。
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# =========================
# 邮件与飞书通知
# =========================
# 这些配置是“系统默认发送配置”。
# 如果前端绑定页已填写个性化设置，运行时会优先使用前端绑定值。
EMAIL_SENDER=your_email@example.com
EMAIL_PASSWORD=your_email_password_or_smtp_authorization_code
EMAIL_RECEIVERS=receiver1@example.com,receiver2@example.com
EMAIL_SMTP_HOST=smtp.qq.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USE_SSL=true

# 飞书机器人 Webhook。
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/your_webhook_id

# =========================
# 天气模块配置
# =========================
# WEATHER_PROVIDER 支持：
# 1. auto：优先和风天气，失败时回退 Open-Meteo
# 2. qweather：强制使用和风天气
# 3. openmeteo：强制使用 Open-Meteo
WEATHER_PROVIDER=auto
WEATHER_REQUEST_TIMEOUT=10

# 和风天气 Key。
# 如不填写，auto 模式下将只能走 Open-Meteo。
# 注意：
# 1. 请优先使用和风控制台分配的 API Host；
# 2. 不建议长期直接写公共域名 geoapi.qweather.com / devapi.qweather.com；
# 3. 当前项目里 GeoAPI 和 Weather API 都支持指向同一个自定义 API Host。
QWEATHER_API_KEY=your_qweather_api_key
QWEATHER_GEO_BASE_URL=https://your-qweather-api-host
QWEATHER_API_BASE_URL=https://your-qweather-api-host

# Open-Meteo 免费备用源。
OPEN_METEO_API_BASE_URL=https://api.open-meteo.com
OPEN_METEO_GEO_BASE_URL=https://geocoding-api.open-meteo.com

# 默认天气查询地区。
DEFAULT_WEATHER_REGION=北京
